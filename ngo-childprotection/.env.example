# Environment variables for ngo-childprotection connector
TENANT_ID=your-tenant-id
CLIENT_ID=your-client-id
CLIENT_SECRET=your-client-secret
CONNECTOR_STATE_PATH=./state

# Copilot Connector Hosting Platform  auto-discovery (optional)
# Set PLATFORM_URL to enable heartbeat/registration with the platform.
PLATFORM_URL=
PLATFORM_TENANT_ID=internal
REGISTRY_SHARED_SECRET=